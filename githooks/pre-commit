#!/bin/sh
# pre-commit guard for Negev-chan: refuses to commit files containing a
# DeepSeek-shaped API key (bot tokens are NOT matched: their digits are fine
# here; the ledger only uses the token, never stores it).
# Install once with:  git config core.hooksPath githooks

against=$(git rev-parse --verify HEAD 2>/dev/null || echo 4b825dc642cb6eb9a060e54bf8d69288fbee4904)
found=0

# Scan working-tree content of every staged file (added, copied, modified).
for file in $(git diff --cached --name-only --diff-filter=ACM); do
  # Skip deletions and files gone from the worktree.
  [ -f "$file" ] || continue
  if grep -q -e 'sk-[0-9a-fA-F]\{16,\}' -e 'sk-proj-[A-Za-z0-9_-]\{20,\}' -e 'sk-ant-[A-Za-z0-9_-]\{20,\}' "$file" 2>/dev/null; then
    echo "BLOCKED: '$file' looks like it contains an API key." >&2
    found=1
  fi
done

if [ "$found" = "1" ]; then
  echo "Move secrets into .env (gitignored) and try again." >&2
  exit 1
fi
exit 0

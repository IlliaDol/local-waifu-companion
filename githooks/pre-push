#!/bin/sh
# pre-push guard for Negev-chan: refuses to push anything that contains a
# DeepSeek-shaped API key or the raw Telegram bot token.
# Install once with:  git config core.hooksPath githooks
# Tests with fixed strings (fast, zero deps). Keep in sync with pre-commit.

found=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$remote_sha" ] && [ "$remote_sha" != "0000000000000000000000000000000000000000" ] || remote_sha="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
  for obj in $(git rev-list "$remote_sha..$local_sha" 2>/dev/null); do
    # -a: scan the object; textconv off; binary objects still searched as text
    if git show "$obj" 2>/dev/null | grep -q -e 'sk-[0-9a-fA-F]\{16,\}' -e 'sk-proj-[A-Za-z0-9_-]\{20,\}' -e 'sk-ant-[A-Za-z0-9_-]\{20,\}'; then
      echo "BLOCKED: an API key was found in the objects you are pushing ($obj)." >&2
      found=1
    fi
  done
done

if [ "$found" = "1" ]; then
  echo "Rotate the key at platform.deepseek.com first, then scrub history." >&2
  exit 1
fi
exit 0
